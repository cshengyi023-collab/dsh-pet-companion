{
  "name": "dsh-pet-companion",
  "version": "0.4.3",
  "description": "小鲸鲸陪伴面板 v0.4：专注计时（番茄钟/正计时/自定义倒计时）、待办、喝水久坐提醒、桌宠显示控制（含最小化自动隐藏）、课程讲解与作业辅导。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "assets/plugin-icon.png",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/plugin-icon.png",
    "README.md",
    "README.en.md",
    "INTRO.md",
    "LIMITATIONS.md",
    "NOTICE-ARTWORK.md",
    "LICENSE",
    "tests"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pet",
    "companion",
    "pomodoro",
    "todo",
    "study",
    "tts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cshengyi023-collab/dsh-pet-companion.git"
  },
  "homepage": "https://github.com/cshengyi023-collab/dsh-pet-companion#readme",
  "bugs": {
    "url": "https://github.com/cshengyi023-collab/dsh-pet-companion/issues"
  }
}